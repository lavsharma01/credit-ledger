# Copy to .env.local (never commit it).

# true = in-memory fake contract with demo wallets, no deployment needed.
NEXT_PUBLIC_USE_MOCK=true

# Which network the app targets: sepolia (default) or anvil.
NEXT_PUBLIC_CHAIN=sepolia

# Optional: custom RPC URL for the target chain (defaults to a public endpoint).
NEXT_PUBLIC_RPC_URL=

# Optional: override the address from shared/deployments.json.
NEXT_PUBLIC_CONTRACT_ADDRESS=
